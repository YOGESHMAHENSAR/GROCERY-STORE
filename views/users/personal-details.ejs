<%- layout("/layouts/boilerplate") -%>

<div class="container-fluid">
    <h3 class="mt-3 mb-5 offset-3 mt-4">Personal Details:</h3>
  <div class="col-md-6 offset-3 mt-4 d-flex justify-content-center personal-info">
    <form
      action="/profile/personal-details"
      method="post"
      class="needs-validation"
      novalidate
    >
      <div class="mb-4">
        <label for="name" class="form-label">Name: </label>
        <input
          type="text"
          id="name"
          name="name"
          class="form-control box-size"
          value="<%= name || '' %>"
        />
      </div>
      <div class="mb-4">
        <label for="mail" class="form-label">Email: </label>
        <input
          type="text"
          id="mail"
          name="mail"
          class="form-control box-size"
          value="<%= mail || '' %>"
        />
      </div>
      <div class="mb-4">
        <label for="phone" class="form-label">Phone: </label>
        <input
          type="text"
          id="phone"
          name="phone"
          class="form-control box-size"
          value="<%= phone || '' %>"
        />
      </div>
      <!-- <div class="mb-3">
                <label for="password" class="form-label">Name: </label>
                <input type="text" id="password" class="form-control " value="<%# password %> || '' ">
            </div> -->
      <button class="btn btn-outline-dark text-center w-40 mb-3">
        Save Changes
      </button>
    </form>
  </div>
</div>
