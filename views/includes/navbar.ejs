            </a>
          </li>
        <% } else { %>
          <li class="nav-item w-100 w-md-auto">
            <a class="nav-link d-flex align-items-center gap-2
              <%= category === 'Snacks' ? 'active' : '' %>"
              href="/listings?category=Snacks">
              <i class="fa-solid fa-cookie-bite" style="font-size: 1.3rem; width:22px; text-align:center; color: brown;"></i>
              <span style="font-size: 1.1rem; font-weight: 500;">Snacks &amp; Sweets</span>
