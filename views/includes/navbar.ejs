<!-- Logout modal -->
<div class="modal fade" id="logout" tabindex="-1" aria-labelledby="logoutLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="logoutLabel"><b>LOGOUT!</b></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to <b>LOGOUT</b>?</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">NO</button>
        <form action="/logout">
          <button class="btn btn-warning">LOGOUT</button>
        </form>
      </div>
      <div class="loader-overlay" id="loaderOverlay">
        <div class="loader-container">
          <div class="loader"></div>
          <p class="loader-text">Logging Out...</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Navbar badge is rendered server-side. No client-side badge creation is required here.
  const badge = document.getElementById("cart-count");
  if (badge) {
      badge.style.display = badge.textContent > 0 ? "inline" : "none";
  }
</script>