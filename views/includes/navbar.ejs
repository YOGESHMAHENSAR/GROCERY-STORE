          <li class="nav-item">
            <a class="nav-link p-0" href="/login">
              <button class="btn btn-outline-dark btn-sm" style="font-size: 1.1rem;">Login</button>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link p-0" href="/signup">
              <button class="btn btn-outline-dark btn-sm" style="font-size: 1.1rem;">Sign Up</button>
            </a>
          </li>
